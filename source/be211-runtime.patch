+    if (len == sizeof(iwx_be211_shared_mem_v4)) {
+        const auto *info =
+            (const iwx_be211_shared_mem_v4 *)cmd.resp_pkt->data;
+        unsigned lmacs = le32toh(info->lmac_num);
+        IOLog("BE211 probe: SHARED_MEM_CFG bytes=%zu LMACs=%u RXFIFO2=%u control=%u\n",
+              len, lmacs, le32toh(info->rxfifo2_size),
+              le32toh(info->rxfifo2_control_size));
+        if (lmacs < 1 || lmacs > 2)
+            err = EIO;
+    } else {
+        IOLog("BE211 probe: unexpected SHARED_MEM_CFG payload=%zu expected=%zu\n",
+              len, sizeof(iwx_be211_shared_mem_v4));
+        err = EIO;
+    }
+    iwx_free_resp(sc, &cmd);
+    return err;
+}
