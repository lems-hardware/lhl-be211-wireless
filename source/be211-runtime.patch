+void ItlIwx::iwx_be211_auth_response(struct iwx_softc *sc, const iwx_rx_packet *pkt)
+{
+    const size_t payload_length = iwx_rx_packet_payload_len(pkt);
+    if (payload_length < sizeof(iwx_rx_mpdu_desc))
+        return;
+    const auto *desc = reinterpret_cast<const iwx_rx_mpdu_desc *>(pkt->data);
+    const size_t frame_length = le16toh(desc->mpdu_len);
+    const uint32_t good = IWX_RX_MPDU_RES_STATUS_CRC_OK | IWX_RX_MPDU_RES_STATUS_OVERRUN_OK;
+    const unsigned trailer = (desc->mac_flags1 & IWX_RX_MPDU_MFLG1_MIC_CRC_LEN_MASK) >>
+                              IWX_RX_MPDU_MFLG1_MIC_CRC_LEN_SHIFT;
+    const size_t body_offset = sizeof(ieee80211_frame) +
+        ((desc->mac_flags2 & IWX_RX_MPDU_MFLG2_PAD) ? 2 : 0);
+    const unsigned band = (desc->mac_phy_idx & IWX_RX_MPDU_BAND_MASK) >> IWX_RX_MPDU_BAND_POS;
+    if ((le32toh(desc->status) & good) != good ||
+        frame_length > payload_length - sizeof(*desc) ||
+        frame_length < body_offset + 6 + trailer || band != IWX_PHY_BAND_24 ||
+        desc->v3.channel != sc->sc_be211_auth_channel)
+        return;
+    const auto *frame = reinterpret_cast<const ieee80211_frame *>(desc + 1);
+    if (frame->i_fc[0] != sc->sc_be211_mgmt_response_subtype ||
+        (frame->i_fc[1] & (IEEE80211_FC1_DIR_MASK | IEEE80211_FC1_PROTECTED)) ||
+        !IEEE80211_ADDR_EQ(frame->i_addr1, sc->sc_nvm.hw_addr) ||
+        !IEEE80211_ADDR_EQ(frame->i_addr2, sc->sc_be211_auth_bssid) ||
+        !IEEE80211_ADDR_EQ(frame->i_addr3, sc->sc_be211_auth_bssid))
+        return;
+    const auto *body = reinterpret_cast<const uint8_t *>(frame) + body_offset;
+    if (frame->i_fc[0] == IEEE80211_FC0_SUBTYPE_AUTH) {
+        if (body[0] || body[1] || body[2] != 2 || body[3])
+            return;
+        sc->sc_be211_auth_rx_status = body[4] | (body[5] << 8);
+        IOLog("BE211 probe: authentication response transaction=2 status=%u\n",
+              static_cast<unsigned>(sc->sc_be211_auth_rx_status));
+    } else {
+        sc->sc_be211_auth_rx_status = body[2] | (body[3] << 8);
+        sc->sc_be211_assoc_aid = (body[4] | (body[5] << 8)) & 0x3fff;
+        IOLog("BE211 probe: association response status=%u aid=%u\n",
+              static_cast<unsigned>(sc->sc_be211_auth_rx_status),
+              static_cast<unsigned>(sc->sc_be211_assoc_aid));
+    }
+    sc->sc_be211_auth_events |= be211_auth_rx_complete;
+    getMainCommandGate()->commandWakeup(&sc->sc_be211_auth_events);
+}
