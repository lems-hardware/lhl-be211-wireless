+struct be211_bsd_tx_ring {
+    uint16_t read;
+    uint16_t write;
+
+    unsigned pending() const { return static_cast<uint16_t>(write - read); }
+    unsigned index() const { return write & (be211_probe_slots - 1); }
+
+    unsigned complete(uint16_t next)
+    {
+        const unsigned released = static_cast<uint16_t>(next - read);
+        if (!released || released > pending())
+            return 0;
+        read = next;
+        return released;
+    }
+};
