+void ItlIwx::iwx_be211_bsd_input(struct iwx_softc *sc, const iwx_rx_packet *pkt, struct mbuf_list *ml)
+{
+    auto &bridge = *sc->sc_be211_bsd;
+    const size_t payload_length = iwx_rx_packet_payload_len(pkt);
+    if (payload_length < sizeof(iwx_rx_mpdu_desc) || sc->sc_be211_bsd_stop)
+        return;
+    const auto *desc = reinterpret_cast<const iwx_rx_mpdu_desc *>(pkt->data);
+    const size_t frame_length = le16toh(desc->mpdu_len);
+    const uint32_t good = IWX_RX_MPDU_RES_STATUS_CRC_OK | IWX_RX_MPDU_RES_STATUS_OVERRUN_OK;
+    const unsigned trailer = (desc->mac_flags1 & IWX_RX_MPDU_MFLG1_MIC_CRC_LEN_MASK) >>
+                              IWX_RX_MPDU_MFLG1_MIC_CRC_LEN_SHIFT;
+    const unsigned band = (desc->mac_phy_idx & IWX_RX_MPDU_BAND_MASK) >> IWX_RX_MPDU_BAND_POS;
+    if ((le32toh(desc->status) & good) != good ||
+        frame_length > payload_length - sizeof(*desc) ||
+        frame_length < sizeof(ieee80211_frame) + trailer || band != IWX_PHY_BAND_24 ||
+        desc->v3.channel != sc->sc_be211_auth_channel ||
+        (desc->mac_flags2 & IWX_RX_MPDU_MFLG2_AMSDU))
+        return;
+    const auto *frame = reinterpret_cast<const ieee80211_frame *>(desc + 1);
+    const bool qos = frame->i_fc[0] == (IEEE80211_FC0_TYPE_DATA | IEEE80211_FC0_SUBTYPE_QOS);
+    const uint8_t broadcast[] = {0xff, 0xff, 0xff, 0xff, 0xff, 0xff};
+    if ((!qos && frame->i_fc[0] != IEEE80211_FC0_TYPE_DATA) ||
+        (frame->i_fc[1] & (IEEE80211_FC1_DIR_MASK | IEEE80211_FC1_PROTECTED |
+                           IEEE80211_FC1_MORE_FRAG | IEEE80211_FC1_ORDER)) != IEEE80211_FC1_DIR_FROMDS ||
+        (frame->i_seq[0] & 0xf) ||
+        !IEEE80211_ADDR_EQ(frame->i_addr2, sc->sc_be211_auth_bssid) ||
+        (!IEEE80211_ADDR_EQ(frame->i_addr1, sc->sc_nvm.hw_addr) &&
+         !IEEE80211_ADDR_EQ(frame->i_addr1, broadcast)))
+        return;
+    const size_t body_offset = sizeof(*frame) + (qos ? 2 : 0) +
+        ((desc->mac_flags2 & IWX_RX_MPDU_MFLG2_PAD) ? 2 : 0);
+    if (frame_length < trailer + body_offset + be211_snap_size)
+        return;
+    const auto *snap = reinterpret_cast<const uint8_t *>(frame) + body_offset;
+    if (memcmp(snap, be211_snap_prefix, sizeof(be211_snap_prefix)))
+        return;
+    const unsigned protocol = be211_get_be16(snap + sizeof(be211_snap_prefix));
+    const auto *payload = snap + be211_snap_size;
+    const size_t length = frame_length - trailer - body_offset - be211_snap_size;
+    if (length > ETHERMTU)
+        return;
+
+    be211_echo_request *matched_echo = nullptr;
+    const uint8_t *echo = protocol == ETHERTYPE_IP && bridge.ack_forwarded &&
+        IEEE80211_ADDR_EQ(frame->i_addr1, sc->sc_nvm.hw_addr) ?
+        be211_echo_header(payload, length, 0) : nullptr;
+    if (echo) {
+        for (auto &request : bridge.echoes) {
+            if (request.pending && !memcmp(request.addresses, payload + 16, 4) &&
+                !memcmp(request.addresses + 4, payload + 12, 4) &&
+                !memcmp(request.identifier_sequence, echo + 4, sizeof(request.identifier_sequence))) {
+                matched_echo = &request;
+                break;
+            }
+        }
+        if (!matched_echo)
+            return;
+    }
+
+    const unsigned web_port = protocol == ETHERTYPE_IP && bridge.ack_forwarded &&
+        IEEE80211_ADDR_EQ(frame->i_addr1, sc->sc_nvm.hw_addr) ?
+        be211_web_port(payload, length, false, bridge.lease_address) : 0;
+    uint8_t dhcp_type = 0;
+    uint8_t offered_address[4] = {};
+    if (!matched_echo && !web_port) {
+        if (protocol == ETHERTYPE_IP && bridge.xid_valid) {
+            uint32_t xid = 0;
+            dhcp_type = be211_dhcp_type(payload, length, false, sc->sc_nvm.hw_addr, &xid, offered_address);
+            if (xid != bridge.xid ||
+                (dhcp_type != be211_dhcp_offer && dhcp_type != be211_dhcp_ack && dhcp_type != be211_dhcp_nak))
+                return;
+        } else if (protocol != ETHERTYPE_ARP || length < 28) {
+            return;
+        }
+    }
+
+    constexpr unsigned alignment = 2;
+    const size_t ethernet_length = sizeof(ether_header) + length;
+    mbuf_t packet = nullptr;
+    unsigned chunks = 1;
+    if (mbuf_allocpacket(MBUF_DONTWAIT, ethernet_length + alignment, &chunks, &packet))
+        return;
+    auto *data = static_cast<uint8_t *>(mbuf_data(packet)) + alignment;
+    if (mbuf_setdata(packet, data, ethernet_length)) {
+        mbuf_freem(packet);
+        return;
+    }
+    auto *ethernet = reinterpret_cast<ether_header *>(data);
+    IEEE80211_ADDR_COPY(ethernet->ether_dhost, frame->i_addr1);
+    IEEE80211_ADDR_COPY(ethernet->ether_shost, frame->i_addr3);
+    memcpy(&ethernet->ether_type, snap + sizeof(be211_snap_prefix), sizeof(ethernet->ether_type));
+    memcpy(data + sizeof(*ethernet), payload, length);
+    mbuf_pkthdr_setlen(packet, ethernet_length);
+    ml_enqueue(ml, packet);
+
+    ++bridge.rx;
+    if (matched_echo) {
+        matched_echo->pending = false;
+        ++bridge.echo_rx;
+        IOLog("BE211 probe: BSD ICMP RX queued id=%u seq=%u\n",
+              be211_get_be16(echo + 4), be211_get_be16(echo + 6));
+    }
+    if (web_port) {
+        ++bridge.web_rx;
+        if (bridge.web_rx <= be211_web_trace_limit)
+            IOLog("BE211 probe: BSD web RX queued ip_protocol=%u remote_port=%u bytes=%zu\n",
+                  payload[9], web_port, length);
+    }
+    if (dhcp_type == be211_dhcp_ack) {
+        bridge.ack_forwarded = true;
+        memcpy(bridge.lease_address, offered_address, sizeof(bridge.lease_address));
+    } else if (dhcp_type == be211_dhcp_nak) {
+        bzero(bridge.lease_address, sizeof(bridge.lease_address));
+    }
+    if (dhcp_type || bridge.rx <= 8)
+        IOLog("BE211 probe: BSD RX queued protocol=0x%x DHCP type=%u bytes=%zu\n",
+              protocol, dhcp_type, ethernet_length);
+}
