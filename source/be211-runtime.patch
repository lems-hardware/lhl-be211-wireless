+// Core 106's v18 request adds one channel slot ahead of the schedule.
+struct iwx_be211_scan_request_v18 {
+    uint32_t uid;
+    uint32_t ooc_priority;
+    struct iwx_api86_scan_general general;
+    uint8_t channel_flags;
+    uint8_t channel_count;
+    uint8_t n_aps_override[2];
+    struct iwx_api86_scan_channel channels[68];
+    struct iwx_scan_periodic_parms_v1 periodic;
+    struct iwx_scan_probe_params_v4 probe;
+} __packed;
+
+static_assert(sizeof(iwx_be211_scan_request_v18) == 1948, "scan v18 request wire size");
+static_assert(offsetof(iwx_be211_scan_request_v18, periodic) == 592, "scan v18 schedule offset");
+
+int ItlIwx::
+iwx_be211_passive_scan(struct iwx_softc *sc, uint16_t channel_mask)
+{
+    unsigned version = iwx_lookup_cmd_ver(sc, IWX_LONG_GROUP, IWX_SCAN_REQ_UMAC);
+    unsigned completion_version = iwx_lookup_notif_ver(sc, IWX_LEGACY_GROUP,
+                                                       IWX_SCAN_COMPLETE_UMAC);
+    IOLog("BE211 probe: SCAN_REQ_UMAC v%u completion v%u 2.4 GHz mask=0x%x\n",
+          version, completion_version, channel_mask);
+    unsigned rx_version = iwx_lookup_notif_ver(sc, IWX_LEGACY_GROUP, IWX_REPLY_RX_MPDU_CMD);
+    IOLog("BE211 probe: RX_MPDU descriptor v%u\n", rx_version);
+    if (version != 18 || completion_version != 1 || rx_version != 8 || !channel_mask)
+        return ENOTSUP;
+    if (sc->sc_flags & IWX_FLAG_RFKILL)
+        return EPERM;
+
+    struct iwx_be211_scan_request_v18 request = {};
+    request.ooc_priority = htole32(IWX_SCAN_PRIORITY_EXT_6);
+    request.general.flags = htole16(IWX_UMAC_SCAN_GEN_FLAGS_V2_FORCE_PASSIVE |
+                                    IWX_UMAC_SCAN_GEN_FLAGS_V2_PASS_ALL);
+    request.general.scan_priority = htole32(IWX_SCAN_PRIORITY_EXT_6);
+    for (unsigned index = 0; index < IWX_SCAN_TWO_LMACS; ++index)
+        request.general.passive_dwell[index] = IWL_SCAN_DWELL_PASSIVE;
+    request.channel_flags = IWX_SCAN_CHANNEL_FLAG_ENABLE_CHAN_ORDER;
+    request.periodic.schedule[0].iter_count = 1;
+
+    // The 2.4 GHz entries at indices 0–10 map to channels 1–11.
+    constexpr unsigned channel_band_shift = 30;
+    for (unsigned index = 0; index < 11; ++index) {
+        if (!(channel_mask & (1U << index)))
+            continue;
+        auto &channel = request.channels[request.channel_count++];
+        channel.flags = htole32(static_cast<uint32_t>(IWX_PHY_BAND_24) << channel_band_shift);
+        channel.channel_num = index + 1;
+        channel.iter_count = 1;
+    }
+    // Force passive and leave the probe template and SSID list empty.
+    sc->sc_be211_scan_done = 0;
+    sc->sc_be211_scan_frames = 0;
+    sc->sc_be211_scan_valid_mpdu = 0;
+    sc->sc_be211_scan_beacons = 0;
+    sc->sc_be211_peer_channel = 0;
+    sc->sc_be211_scan_bssid_count = 0;
+    sc->sc_be211_scan_bssid_limit = false;
+    sc->sc_be211_scan_pending = true;
+    int err = iwx_send_cmd_pdu(sc, IWX_WIDE_ID(IWX_LONG_GROUP, IWX_SCAN_REQ_UMAC),
+                               0, sizeof(request), &request);
+    IOLog("BE211 probe: SCAN_REQ_UMAC v18 passive channels=%u bytes=%zu result=%d\n",
+          request.channel_count, sizeof(request), err);
+    if (!err)
+        err = iwx_wait_notification(sc, &sc->sc_be211_scan_done, 1, 4000);
+    sc->sc_be211_scan_pending = false;
+    IOLog("BE211 probe: scan RX valid MPDUs=%u beacons=%u unique BSSIDs=%u limit reached=%u\n",
+          sc->sc_be211_scan_valid_mpdu, sc->sc_be211_scan_beacons,
+          sc->sc_be211_scan_bssid_count, static_cast<unsigned>(sc->sc_be211_scan_bssid_limit));
+    if (!err && sc->sc_be211_scan_status != IWX_SCAN_OFFLOAD_COMPLETED)
+        return EIO;
+    return err;
+}
