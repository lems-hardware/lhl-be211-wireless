+struct AirportItlwmSkywalkInterface::BE211JoinWork {
+    AirportItlwmSkywalkInterface *interface;
+    IOCommandGate *gate;
+    thread_call_t call;
+    uint8_t ssid[IEEE80211_NWID_LEN];
+    size_t ssidLength;
+    uint8_t bssid[IEEE80211_ADDR_LEN];
+};
+
+IOReturn AirportItlwmSkywalkInterface::queueBE211Join(const AirportWCL::JoinRequest &join)
+{
+    if (be211JoinWork || joinPending || scanPending)
+        return kIOReturnBusy;
+    if (!join.ssidLength || join.ssidLength > IEEE80211_NWID_LEN)
+        return kIOReturnBadArgument;
+    auto work = static_cast<BE211JoinWork *>(IOMalloc(sizeof(BE211JoinWork)));
+    if (!work)
+        return kIOReturnNoMemory;
+    work->call = thread_call_allocate(be211JoinThread, work);
+    if (!work->call) {
+        IOFree(work, sizeof(*work));
+        return kIOReturnNoMemory;
+    }
+    work->interface = this;
+    work->gate = _fCommandGate;
+    work->ssidLength = join.ssidLength;
+    memcpy(work->ssid, join.ssid, work->ssidLength);
+    IEEE80211_ADDR_COPY(work->bssid, join.bssid);
+    IEEE80211_ADDR_COPY(joinBSSID, join.bssid);
+    current_authtype_lower = join.lowerAuth;
+    current_authtype_upper = join.upperAuth;
+    assocNotified = firstBeaconNotified = portAuthorized = false;
+    wclBssValid = wclLinkIndicated = false;
+    wclAssociatedBeacons = 0;
+    be211JoinCancelled = false;
+    joinPending = true;
+    be211JoinWork = work;
+    retain();
+    work->gate->retain();
+    IOLog("BE211 probe: WCL join queued\n");
+    thread_call_enter(work->call);
+    return kIOReturnSuccess;
+}
+
+void AirportItlwmSkywalkInterface::be211JoinThread(void *arg, void *)
+{
+    auto work = static_cast<BE211JoinWork *>(arg);
+    work->gate->runAction(be211JoinGated, work);
+    thread_call_free(work->call);
+    work->interface->release();
+    work->gate->release();
+    IOFree(work, sizeof(*work));
+}
+
+IOReturn AirportItlwmSkywalkInterface::be211JoinGated(
+    OSObject *, void *arg, void *, void *, void *)
+{
+    auto work = static_cast<BE211JoinWork *>(arg);
+    auto self = work->interface;
+    auto iwx = OSDynamicCast(ItlIwx, self->fHalService);
+    int err = ECANCELED;
+    if (iwx && !self->wclStopping && !self->be211JoinCancelled && self->instance->power_state)
+        err = iwx->probeBE211Join(work->ssid, work->ssidLength, work->bssid,
+                                  publishBE211Association, self);
+    if (!self->wclStopping && self->joinPending)
+        self->finishWCLJoin(1, 0, err == ECANCELED ? kIOReturnAborted : kIOReturnError);
+    IOLog("BE211 probe: WCL join worker complete result=%d\n", err);
+    self->be211JoinWork = nullptr;
+    work->gate->commandWakeup(&self->be211JoinWork);
+    return kIOReturnSuccess;
+}
+
+bool AirportItlwmSkywalkInterface::publishBE211Association(
+    void *arg, const ieee80211_beacon_event &beacon)
+{
+    auto self = static_cast<AirportItlwmSkywalkInterface *>(arg);
+    if (self->wclStopping || self->be211JoinCancelled || !self->joinPending)
+        return false;
+    IEEE80211_ADDR_COPY(self->joinBSSID, beacon.node->ni_bssid);
+    auto ic = self->fHalService->get80211Controller();
+    ic->ic_assoc_status = 0;
+    ic->ic_wcl_peer_is_mlo = false;
+    self->handleWCLEvent(IEEE80211_EVT_STA_ASSOC_DONE, nullptr);
+    auto event = beacon;
+    self->handleWCLEvent(IEEE80211_EVT_BEACON, &event);
+    IOLog("BE211 probe: WCL real peer beacon published=%u\n",
+          static_cast<unsigned>(self->firstBeaconNotified));
+    return self->firstBeaconNotified;
+}
+
+bool AirportItlwmSkywalkInterface::copyBE211CurrentBss(AirportWCL::BeaconMetadata &bss)
+{
+    auto iwx = OSDynamicCast(ItlIwx, fHalService);
+    return iwx && iwx->isBE211ScanOnly() && _fCommandGate &&
+        _fCommandGate->runAction(wclCommand, this, reinterpret_cast<void *>(16), &bss) ==
+            kIOReturnSuccess;
+}
