+int ItlIwx::
+iwx_be211_mcc_probe(struct iwx_softc *sc, uint16_t *scan_channels)
+{
+    unsigned command_version = iwx_lookup_cmd_ver(sc, IWX_LONG_GROUP, IWX_MCC_UPDATE_CMD);
+    unsigned response_version = iwx_lookup_notif_ver(sc, IWX_LONG_GROUP, IWX_MCC_UPDATE_CMD);
+    IOLog("BE211 probe: MCC_UPDATE command v%u response v%u\n",
+          command_version, response_version);
+    if (command_version != 1 || response_version != 9)
+        return ENOTSUP;
+
+    // Linux MLD uses the 28-byte request and v8 wire layout for v9 replies.
+    static_assert(sizeof(iwx_mcc_update_cmd) == 28, "MCC_UPDATE request size");
+    static_assert(sizeof(iwx_mcc_update_resp_v8) == 24, "MCC_UPDATE response header size");
+    struct iwx_mcc_update_cmd request = {};
+    request.mcc = htole16(('Z' << 8) | 'Z');
+    request.source_id = IWX_MCC_SOURCE_GET_CURRENT;
+
+    struct iwx_host_cmd cmd = {};
+    cmd.id = IWX_MCC_UPDATE_CMD;
+    cmd.flags = IWX_CMD_WANT_RESP;
+    cmd.data[0] = &request;
+    cmd.len[0] = sizeof(request);
+    cmd.resp_pkt_len = IWX_CMD_RESP_MAX;
+    int err = iwx_send_cmd(sc, &cmd);
+    if (err)
+        return err;
+    if (!cmd.resp_pkt)
+        return EIO;
+
+    struct iwx_mcc_response_view view = {};
+    err = iwx_parse_mcc_update_response(cmd.resp_pkt, response_version, false, &view);
+    size_t bytes = iwx_rx_packet_payload_len(cmd.resp_pkt);
+    if (!err) {
+        IOLog("BE211 probe: MCC_UPDATE bytes=%zu status=0x%x MCC=0x%04x source=%u cap=0x%x geo=0x%x channels=%u\n",
+              bytes, view.status, view.mcc, view.source_id, view.cap,
+              view.geo_info, view.n_channels);
+        if (!view.mcc || !view.n_channels ||
+            (view.status != IWX_MCC_RESP_NEW_CHAN_PROFILE &&
+             view.status != IWX_MCC_RESP_SAME_CHAN_PROFILE))
+            err = EIO;
+        if (!err) {
+            sc->sc_be211_mcc_active_channels = 0;
+            for (unsigned index = 0; index < MIN(view.n_channels, 11U); ++index) {
+                uint32_t flags = le32toh(view.channels[index]);
+                if (flags & IWX_NVM_CHANNEL_VALID)
+                    *scan_channels |= 1U << index;
+                if ((flags & (IWX_NVM_CHANNEL_VALID | IWX_NVM_CHANNEL_ACTIVE | IWX_NVM_CHANNEL_RADAR)) ==
+                    (IWX_NVM_CHANNEL_VALID | IWX_NVM_CHANNEL_ACTIVE))
+                    sc->sc_be211_mcc_active_channels |= 1U << index;
+            }
+        }
+    } else {
+        IOLog("BE211 probe: MCC_UPDATE invalid response bytes=%zu channels=%u\n",
+              bytes, view.n_channels);
+    }
+    iwx_free_resp(sc, &cmd);
+    return err;
+}
