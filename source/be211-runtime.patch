+void ItlIwx::
+iwx_be211_count_beacon(struct iwx_softc *sc, const struct iwx_rx_packet *pkt)
+{
+    // RX MPDU v8 keeps the v3 tail and the common length and status offsets.
+    static_assert(sizeof(iwx_rx_mpdu_desc) == 64, "RX MPDU v8 descriptor size");
+    static_assert(offsetof(iwx_rx_mpdu_desc, status) == 12, "RX MPDU status offset");
+    static_assert(offsetof(iwx_rx_mpdu_desc, v3.channel) == 42, "RX MPDU channel offset");
+    ++sc->sc_be211_scan_frames;
+    const size_t payload_len = iwx_rx_packet_payload_len(pkt);
+    if (payload_len < sizeof(iwx_rx_mpdu_desc))
+        return;
+
+    const auto *desc = reinterpret_cast<const iwx_rx_mpdu_desc *>(pkt->data);
+    const size_t frame_len = le16toh(desc->mpdu_len);
+    const uint32_t good_status = IWX_RX_MPDU_RES_STATUS_CRC_OK |
+                                 IWX_RX_MPDU_RES_STATUS_OVERRUN_OK;
+    if (!frame_len || frame_len > payload_len - sizeof(*desc) ||
+        (le32toh(desc->status) & good_status) != good_status)
+        return;
+    ++sc->sc_be211_scan_valid_mpdu;
+
+    const size_t pad = (desc->mac_flags2 & IWX_RX_MPDU_MFLG2_PAD) ? 2 : 0;
+    constexpr size_t beacon_fixed_len = 12; // Timestamp, interval and capability.
+    unsigned band = (desc->mac_phy_idx & IWX_RX_MPDU_BAND_MASK) >> IWX_RX_MPDU_BAND_POS;
+    if (band != IWX_PHY_BAND_24 || desc->v3.channel < 1 || desc->v3.channel > 11 ||
+        frame_len < sizeof(ieee80211_frame) + pad + beacon_fixed_len)
+        return;
+
+    const auto *frame = reinterpret_cast<const ieee80211_frame *>(desc + 1);
+    const size_t trailer = (desc->mac_flags1 & IWX_RX_MPDU_MFLG1_MIC_CRC_LEN_MASK) >>
+                           IWX_RX_MPDU_MFLG1_MIC_CRC_LEN_SHIFT;
+    if (sc->sc_be211_bsd_active && desc->v3.channel == sc->sc_be211_auth_channel &&
+        frame_len >= sizeof(*frame) + pad + sizeof(uint16_t) + trailer &&
+        (frame->i_fc[0] == IEEE80211_FC0_SUBTYPE_DISASSOC ||
+         frame->i_fc[0] == IEEE80211_FC0_SUBTYPE_DEAUTH) &&
+        !(frame->i_fc[1] & (IEEE80211_FC1_DIR_MASK | IEEE80211_FC1_PROTECTED)) &&
+        IEEE80211_ADDR_EQ(frame->i_addr1, sc->sc_nvm.hw_addr) &&
+        IEEE80211_ADDR_EQ(frame->i_addr2, sc->sc_be211_auth_bssid) &&
+        IEEE80211_ADDR_EQ(frame->i_addr3, sc->sc_be211_auth_bssid)) {
+        const auto *reason = reinterpret_cast<const uint8_t *>(frame + 1) + pad;
+        IOLog("BE211 probe: BSD peer disconnect subtype=0x%x reason=%u\n",
+              frame->i_fc[0], static_cast<unsigned>(reason[0] | (reason[1] << 8)));
+        sc->sc_be211_bsd_stop = 1;
+        getMainCommandGate()->commandWakeup(&sc->sc_be211_bsd_stop);
+        return;
+    }
+    if (frame->i_fc[0] != IEEE80211_FC0_SUBTYPE_BEACON ||
+        (frame->i_fc[1] & (IEEE80211_FC1_DIR_MASK | IEEE80211_FC1_PROTECTED)) ||
+        !iwx_is_valid_mac_addr(frame->i_addr3))
+        return;
+
+    const size_t elements_offset = sizeof(*frame) + pad + beacon_fixed_len;
+    const uint8_t *ssid = reinterpret_cast<const uint8_t *>(frame) + elements_offset;
+    const size_t elements_len = frame_len - elements_offset;
+    const bool pinned_peer = sc->sc_be211_join_pin_bssid &&
+        IEEE80211_ADDR_EQ(frame->i_addr3, sc->sc_be211_auth_bssid);
+    const auto log_join_beacon = [&](const char *outcome) {
+        constexpr unsigned max_beacon_logs = 32;
+        if (sc->sc_be211_join_beacon_logs == max_beacon_logs)
+            IOLog("BE211 probe: join beacon trace limit reached\n");
+        if (sc->sc_be211_join_beacon_logs <= max_beacon_logs)
+            ++sc->sc_be211_join_beacon_logs;
+        if (sc->sc_be211_join_beacon_logs > max_beacon_logs)
+            return;
+        const auto *addr = frame->i_addr3;
+        IOLog("BE211 probe: join beacon bssid=%02x:%02x:%02x:%02x:%02x:%02x channel=%u requested=%u outcome=%s\n",
+              addr[0], addr[1], addr[2], addr[3], addr[4], addr[5],
+              static_cast<unsigned>(desc->v3.channel), static_cast<unsigned>(pinned_peer), outcome);
+    };
+    if (elements_len < 2 || ssid[0] != IEEE80211_ELEMID_SSID ||
+        ssid[1] > IEEE80211_NWID_LEN || ssid[1] > elements_len - 2) {
+        if (sc->sc_be211_runtime_join && pinned_peer && !sc->sc_be211_peer_channel &&
+            !sc->sc_be211_post_assoc_observing)
+            log_join_beacon("missing-or-invalid-ssid-element");
+        return;
+    }
+
+    if (sc->sc_be211_post_assoc_observing) {
+        if (desc->v3.channel == sc->sc_be211_auth_channel &&
+            IEEE80211_ADDR_EQ(frame->i_addr2, sc->sc_be211_auth_bssid) &&
+            IEEE80211_ADDR_EQ(frame->i_addr3, sc->sc_be211_auth_bssid)) {
+            // Keep the actual peer frame for WCL publication and beacon queries.
+            if (sc->sc_be211_association_observer) {
+                if (elements_len < trailer + 2 + ssid[1] ||
+                    ssid[1] != sc->sc_be211_auth_ssid_len ||
+                    memcmp(ssid + 2, sc->sc_be211_auth_ssid, ssid[1]) ||
+                    frame_len - pad - trailer > sizeof(sc->sc_be211_peer_beacon))
+                    return;
+                auto *beacon = sc->sc_be211_peer_beacon;
+                memcpy(beacon, frame, sizeof(*frame));
+                memcpy(beacon + sizeof(*frame), reinterpret_cast<const uint8_t *>(frame) +
+                       sizeof(*frame) + pad, frame_len - sizeof(*frame) - pad - trailer);
+                sc->sc_be211_peer_beacon_size = frame_len - pad - trailer;
+                sc->sc_be211_peer_beacon_rssi = MIN(sc->sc_ic.ic_max_rssi,
+                    MAX(0, iwx_rxmq_get_signal_strength(sc,
+                        const_cast<iwx_rx_mpdu_desc *>(desc)) - IWX_MIN_DBM));
+            }
+            if (!sc->sc_be211_post_assoc_beacon) {
+                IOLog("BE211 probe: post-association beacon from peer channel=%u\n",
+                      static_cast<unsigned>(desc->v3.channel));
+                sc->sc_be211_post_assoc_beacon = 1;
+                getMainCommandGate()->commandWakeup(&sc->sc_be211_post_assoc_beacon);
+            }
+
+        }
+        return;
+    }
+    ++sc->sc_be211_scan_beacons;
+    if (!sc->sc_be211_runtime_scan && !sc->sc_be211_peer_channel) {
+        const uint8_t *fixed = ssid - beacon_fixed_len;
+        const uint16_t interval = fixed[8] | (fixed[9] << 8);
+        const uint16_t capabilities = fixed[10] | (fixed[11] << 8);
+        const char *rejection = nullptr;
+        bool match = !sc->sc_be211_auth_target_configured ||
+            (desc->v3.channel == sc->sc_be211_auth_channel &&
+             IEEE80211_ADDR_EQ(frame->i_addr3, sc->sc_be211_auth_bssid));
+        if (sc->sc_be211_auth_ssid_len) {
+            const unsigned bit = 1U << (desc->v3.channel - 1);
+            const bool ssid_match = ssid[1] == sc->sc_be211_auth_ssid_len &&
+                memcmp(ssid + 2, sc->sc_be211_auth_ssid, ssid[1]) == 0;
+            if (!ssid_match)
+                rejection = "ssid-mismatch";
+            else if (sc->sc_be211_join_pin_bssid && !pinned_peer)
+                rejection = "bssid-mismatch";
+            else if (capabilities & IEEE80211_CAPINFO_PRIVACY)
+                rejection = "privacy-bit";
+            else if (!(sc->sc_be211_nvm_active_channels & sc->sc_be211_mcc_active_channels & bit))
+                rejection = "channel-not-active";
+            else if (elements_len < size_t(2 + ssid[1]) + trailer)
+                rejection = "truncated-elements";
+            match = !rejection;
+            if (match) {
+                constexpr uint8_t legacy_rates[] = {2, 4, 11, 22, 12, 18, 24, 36, 48, 72, 96, 108};
+                unsigned count = 0;
+                unsigned seen = 0;
+                size_t offset = 2 + ssid[1];
+                const size_t end = elements_len - trailer;
+                while (offset + 2 <= end) {
+                    const auto *ie = ssid + offset;
+                    if (ie[1] > end - offset - 2) {
+                        rejection = "truncated-element";
+                        break;
+                    }
+                    if (ie[0] == IEEE80211_ELEMID_RSN ||
+                        (ie[0] == IEEE80211_ELEMID_VENDOR && ie[1] >= 4 &&
+                         ie[2] == 0 && ie[3] == 0x50 && ie[4] == 0xf2 && ie[5] == 1)) {
+                        rejection = "rsn-or-wpa-element";
+                        break;
+                    }
+                    if (ie[0] == IEEE80211_ELEMID_RATES || ie[0] == IEEE80211_ELEMID_XRATES) {
+                        for (unsigned i = 0; i < ie[1]; ++i) {
+                            const uint8_t rate = ie[2 + i];
+                            for (unsigned j = 0; j < nitems(legacy_rates); ++j) {
+                                if ((rate & 0x7f) == legacy_rates[j] && !(seen & (1U << j))) {
+                                    sc->sc_be211_assoc_rates[count++] = rate;
+                                    seen |= 1U << j;
+                                    break;
+                                }
+                            }
+                        }
+                    }
+                    offset += 2 + ie[1];
+                }
+                match = offset == end && count != 0;
+                if (!match && !rejection)
+                    rejection = offset == end ? "no-usable-legacy-rates" : "trailing-element-byte";
+                sc->sc_be211_assoc_rate_count = count;
+            }
+            if (sc->sc_be211_runtime_join && (pinned_peer || ssid_match)) {
+                if (match) {
+                    if (!interval)
+                        rejection = "zero-beacon-interval";
+                    else if (!(capabilities & IEEE80211_CAPINFO_ESS) ||
+                             (capabilities & IEEE80211_CAPINFO_IBSS))
+                        rejection = "not-infrastructure";
+                    else if (!IEEE80211_ADDR_EQ(frame->i_addr2, frame->i_addr3))
+                        rejection = "transmitter-bssid-mismatch";
+                }
+                log_join_beacon(rejection ? rejection : "eligible");
+            }
+        }
+        if (interval && (capabilities & IEEE80211_CAPINFO_ESS) &&
+            !(capabilities & IEEE80211_CAPINFO_IBSS) &&
+            IEEE80211_ADDR_EQ(frame->i_addr2, frame->i_addr3) &&
+            match) {
+            sc->sc_be211_peer_channel = desc->v3.channel;
+            sc->sc_be211_peer_beacon_interval = interval;
+            IEEE80211_ADDR_COPY(sc->sc_be211_peer_bssid, frame->i_addr3);
+        }
+    }
+#ifdef AIRPORT_WCL
+    if (sc->sc_be211_runtime_scan && sc->sc_ic.ic_event_handler) {
+        if (ssid[1] && trailer <= elements_len &&
+            size_t(ssid[1]) + 2 <= elements_len - trailer &&
+            sc->sc_ic.ic_channels[desc->v3.channel].ic_freq) {
+            // The event is consumed synchronously. This node never enters net80211.
+            struct ieee80211_node node = {};
+            IEEE80211_ADDR_COPY(node.ni_bssid, frame->i_addr3);
+            node.ni_chan = &sc->sc_ic.ic_channels[desc->v3.channel];
+            const auto *fixed = ssid - beacon_fixed_len;
+            node.ni_intval = fixed[8] | (fixed[9] << 8);
+            node.ni_capinfo = fixed[10] | (fixed[11] << 8);
+            node.ni_rssi = MIN(sc->sc_ic.ic_max_rssi,
+                MAX(0, iwx_rxmq_get_signal_strength(sc,
+                    const_cast<iwx_rx_mpdu_desc *>(desc)) - IWX_MIN_DBM));
+            node.ni_esslen = ssid[1];
+            memcpy(node.ni_essid, ssid + 2, node.ni_esslen);
+            struct ieee80211_beacon_event event = { &node, ssid, elements_len - trailer,
+                                                    nullptr, 0 };
+            sc->sc_ic.ic_event_handler(&sc->sc_ic, IEEE80211_EVT_BEACON, &event);
+        }
+    }
+#endif
+    for (unsigned index = 0; index < sc->sc_be211_scan_bssid_count; ++index) {
+        if (memcmp(sc->sc_be211_scan_bssids[index], frame->i_addr3, IEEE80211_ADDR_LEN) == 0)
+            return;
+    }
+    if (sc->sc_be211_scan_bssid_count == nitems(sc->sc_be211_scan_bssids)) {
+        sc->sc_be211_scan_bssid_limit = true;
+        return;
+    }
+    memcpy(sc->sc_be211_scan_bssids[sc->sc_be211_scan_bssid_count++],
+           frame->i_addr3, IEEE80211_ADDR_LEN);
+}
