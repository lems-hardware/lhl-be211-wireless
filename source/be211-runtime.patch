+
+int ItlIwx::iwx_be211_auth_probe(struct iwx_softc *sc, uint16_t queue,
+                                uint16_t write_pointer, unsigned slots,
+                                iwx_dma_info &descriptors, iwx_dma_info &byte_counts,
+                                iwx_dma_info &command)
+{
+    const unsigned tx_version = iwx_lookup_cmd_ver(sc, IWX_LEGACY_GROUP, IWX_TX_CMD);
+    const unsigned reply_version = iwx_lookup_notif_ver(sc, IWX_LEGACY_GROUP, IWX_TX_CMD);
+    IOLog("BE211 probe: authentication TX versions command=%u response=%u\n",
+          tx_version, reply_version);
+    if (tx_version != 12 || reply_version != 9 || queue >= 32)
+        return ENOTSUP;
+    if ((sc->sc_flags & IWX_FLAG_RFKILL) ||
+        sc->sc_be211_peer_channel != sc->sc_be211_auth_channel ||
+        !IEEE80211_ADDR_EQ(sc->sc_be211_peer_bssid, sc->sc_be211_auth_bssid))
+        return EPERM;
+
+    const auto protection_cmd = IWX_WIDE_ID(IWX_MAC_CONF_GROUP, IWX_SESSION_PROTECTION_CMD);
+    const unsigned protection_version = iwx_lookup_cmd_ver(sc, IWX_MAC_CONF_GROUP,
+                                                           IWX_SESSION_PROTECTION_CMD);
+    const unsigned protection_notif_version = iwx_lookup_notif_ver(sc, IWX_MAC_CONF_GROUP,
+                                                                   IWX_SESSION_PROTECTION_NOTIF);
+    IOLog("BE211 probe: session protection versions command=%u notification=%u\n",
+          protection_version, protection_notif_version);
+    if (protection_version != 2 || protection_notif_version != 3)
+        return ENOTSUP;
+
+    static_assert(sizeof(iwx_session_prot_cmd) == 24 && sizeof(iwx_session_prot_notif) == 16,
+                  "Core 106 session protection layouts");
+    constexpr unsigned protection_duration_tu = 900 * 1000 / 1024;
+    constexpr unsigned protection_start_timeout_ms = 350;
+    struct iwx_session_prot_cmd protection = {};
+    protection.id_and_color = htole32(be211_session_link);
+    protection.action = htole32(IWX_FW_CTXT_ACTION_ADD);
+    protection.conf_id = htole32(IWX_SESSION_PROTECT_CONF_ASSOC);
+    protection.duration_tu = htole32(protection_duration_tu);
+
+    const int generation = sc->sc_generation;
+    sc->sc_be211_session_events = 0;
+    sc->sc_be211_session_pending = true;
+    int err = iwx_send_cmd_pdu(sc, protection_cmd, 0, sizeof(protection), &protection);
+    IOLog("BE211 probe: session protection add link=%u duration=%u TU result=%d\n",
+          be211_session_link, protection_duration_tu, err);
+    if (err) {
+        sc->sc_be211_session_pending = false;
+        return err;
+    }
+
+    const auto remove_protection = [&]() {
+        int remove_err = ENXIO;
+        if (generation == sc->sc_generation) {
+            protection.action = htole32(IWX_FW_CTXT_ACTION_REMOVE);
+            protection.duration_tu = 0;
+            remove_err = iwx_send_cmd_pdu(sc, protection_cmd, 0, sizeof(protection), &protection);
+        }
+        sc->sc_be211_session_pending = false;
+        IOLog("BE211 probe: session protection remove result=%d\n", remove_err);
+        return remove_err;
+    };
+
+    err = iwx_wait_notification(sc, &sc->sc_be211_session_events, be211_session_reported,
+                                protection_start_timeout_ms);
+    if (!err && !(sc->sc_be211_session_events & be211_session_active))
+        err = EIO;
+    if (!err && (sc->sc_flags & IWX_FLAG_RFKILL))
+        err = EPERM;
+    IOLog("BE211 probe: session protection start wait events=0x%x result=%d\n",
+          sc->sc_be211_session_events, err);
+    if (err) {
+        remove_protection();
+        return err;
+    }
+
+    const auto submit = [&](const char *phase_name, uint8_t subtype, uint16_t pointer,
+                            unsigned command_offset, const uint8_t *body, size_t body_size) {
+        if (generation != sc->sc_generation)
+            return ENXIO;
+        if (!(sc->sc_be211_session_events & be211_session_active) ||
+            (sc->sc_flags & IWX_FLAG_RFKILL)) {
+            IOLog("BE211 probe: %s skipped, protected airtime unavailable\n", phase_name);
+            return EPERM;
+        }
+        if (body_size > be211_mgmt_command_stride - be211_probe_body_offset)
+            return EINVAL;
+        auto *command_buffer = static_cast<uint8_t *>(command.vaddr) + command_offset;
+        const uint64_t command_address = command.paddr + command_offset;
+        const unsigned frame_size = sizeof(ieee80211_frame) + body_size;
+        const unsigned index = pointer & (slots - 1);
+        auto *packet = reinterpret_cast<be211_probe_tx_command *>(command_buffer);
+        packet->header.cmd = IWX_TX_CMD;
+        packet->header.idx = index;
+        packet->header.qid = queue;
+        packet->tx.len = htole16(frame_size);
+        // The frame uses the AP peer station. Let firmware select its rate.
+        packet->tx.flags = htole16(IWX_TX_FLAGS_HIGH_PRI | IWX_TX_FLAGS_ENCRYPT_DIS);
+        packet->tx.offload_assist = htole32(itlTxOffloadHeader(sizeof(packet->frame), false));
+        packet->tx.rate_n_flags = 0;
+        packet->frame.i_fc[0] = subtype;
+        IEEE80211_ADDR_COPY(packet->frame.i_addr1, sc->sc_be211_auth_bssid);
+        IEEE80211_ADDR_COPY(packet->frame.i_addr2, sc->sc_nvm.hw_addr);
+        IEEE80211_ADDR_COPY(packet->frame.i_addr3, sc->sc_be211_auth_bssid);
+        memcpy(command_buffer + be211_probe_body_offset, body, body_size);
+        auto &descriptor = static_cast<iwx_tfh_tfd *>(descriptors.vaddr)[index];
+        be211_fill_probe_tfd(descriptor, command_address, body_size);
+        static_cast<uint16_t *>(byte_counts.vaddr)[index] = htole16(frame_size);
+
+        sc->sc_be211_auth_queue = queue;
+        sc->sc_be211_mgmt_index = index;
+        sc->sc_be211_mgmt_response_subtype = subtype == IEEE80211_FC0_SUBTYPE_AUTH ?
+            IEEE80211_FC0_SUBTYPE_AUTH : IEEE80211_FC0_SUBTYPE_ASSOC_RESP;
+        sc->sc_be211_auth_events = 0;
+        sc->sc_be211_auth_raw_notifications = 0;
+        sc->sc_be211_auth_raw_mpdus = 0;
+        sc->sc_be211_auth_pending = true;
+        const unsigned next_pointer = uint16_t(pointer + 1);
+        const uint32_t doorbell = (uint32_t(queue) << 16) | next_pointer;
+        const auto log_rx_ring = [&](const char *phase) {
+            if (generation != sc->sc_generation || !sc->rxq.stat) {
+                IOLog("BE211 probe: %s RX ring %s unavailable after reset\n", phase_name, phase);
+                return;
+            }
+            const unsigned closed = le16toh(*static_cast<volatile uint16_t *>(sc->rxq.stat)) &
+                                    (IWX_RX_MQ_RING_COUNT - 1);
+            IOLog("BE211 probe: %s RX ring %s next=%u closed=%u\n",
+                  phase_name, phase, static_cast<unsigned>(sc->rxq.cur), closed);
+        };
+        IOLog("BE211 probe: %s submit qid=%u index=%u channel=%d flags=0x%x firmware rate\n",
+              phase_name, static_cast<unsigned>(queue), index, sc->sc_be211_auth_channel,
+              static_cast<unsigned>(le16toh(packet->tx.flags)));
+        IOLog("BE211 probe: %s TX write pointer old=%u next=%u doorbell=0x%x bc=%u tbs=%u\n",
+              phase_name, static_cast<unsigned>(pointer), next_pointer, doorbell, frame_size, 3U);
+        log_rx_ring("before");
+        OSSynchronizeIO();
+        IWX_WRITE(sc, IWX_HBUS_TARG_WRPTR, doorbell);
+        const int wait_err = iwx_wait_notification(sc, &sc->sc_be211_auth_events,
+                                    be211_auth_tx_complete | be211_auth_rx_complete, 1200);
+        sc->sc_be211_auth_pending = false;
+        log_rx_ring("after");
+        IOLog("BE211 probe: %s raw summary notifications=%u mpdus=%u\n",
+              phase_name, sc->sc_be211_auth_raw_notifications, sc->sc_be211_auth_raw_mpdus);
+        IOLog("BE211 probe: %s wait events=0x%x result=%d\n",
+              phase_name, sc->sc_be211_auth_events, wait_err);
+        if (wait_err)
+            return wait_err;
+        return sc->sc_be211_auth_rx_status == 0 &&
+               sc->sc_be211_auth_tx_status == IWX_TX_STATUS_SUCCESS ? 0 : EIO;
+    };
+
+    const uint8_t auth_body[] = {0, 0, 1, 0, 0, 0}; // Open System, transaction 1.
+    err = submit("authentication", IEEE80211_FC0_SUBTYPE_AUTH, write_pointer, 0,
+                 auth_body, sizeof(auth_body));
+    if (!err && sc->sc_be211_auth_ssid_len) {
+        // Open ESS, listen interval one beacon, SSID and the AP's legacy rates.
+        uint8_t assoc_body[4 + 2 + IEEE80211_NWID_LEN + 4 + 12] = {1, 0, 1, 0};
+        unsigned length = 4;
+        assoc_body[length++] = IEEE80211_ELEMID_SSID;
+        assoc_body[length++] = sc->sc_be211_auth_ssid_len;
+        memcpy(assoc_body + length, sc->sc_be211_auth_ssid, sc->sc_be211_auth_ssid_len);
+        length += sc->sc_be211_auth_ssid_len;
+        const unsigned rate_count = sc->sc_be211_assoc_rate_count;
+        const unsigned first_rates = MIN(rate_count, 8U);
+        assoc_body[length++] = IEEE80211_ELEMID_RATES;
+        assoc_body[length++] = first_rates;
+        memcpy(assoc_body + length, sc->sc_be211_assoc_rates, first_rates);
+        length += first_rates;
+        if (rate_count > first_rates) {
+            const unsigned extended_rates = rate_count - first_rates;
+            assoc_body[length++] = IEEE80211_ELEMID_XRATES;
+            assoc_body[length++] = extended_rates;
+            memcpy(assoc_body + length, sc->sc_be211_assoc_rates + first_rates, extended_rates);
+            length += extended_rates;
+        }
+        sc->sc_be211_assoc_aid = 0;
+        err = submit("association", IEEE80211_FC0_SUBTYPE_ASSOC_REQ, uint16_t(write_pointer + 1),
+                     be211_mgmt_command_stride, assoc_body, length);
+        IOLog("BE211 probe: association test result=%d\n", err);
+    }
+    bool mac_associated = false;
+    const auto mac_cmd = IWX_WIDE_ID(IWX_MAC_CONF_GROUP, IWX_MLD_MAC_CONFIG_CMD);
+    if (!err && sc->sc_be211_auth_ssid_len) {
+        const uint16_t aid = sc->sc_be211_assoc_aid;
+        if (!aid || aid > 2007) {
+            IOLog("BE211 probe: association handoff invalid aid=%u\n", static_cast<unsigned>(aid));
+            err = EIO;
+        } else {
+            auto peer = be211_peer_context(sc, aid);
+            const auto sta_cmd = IWX_WIDE_ID(IWX_MAC_CONF_GROUP, IWX_MLD_STA_CONFIG_CMD);
+            err = iwx_send_cmd_pdu(sc, sta_cmd, 0, sizeof(peer), &peer);
+            IOLog("BE211 probe: STA_CONFIG v3 associated aid=%u result=%d\n",
+                  static_cast<unsigned>(aid), err);
+            if (!err) {
+                auto mac = be211_mac_context(sc, IWX_FW_CTXT_ACTION_MODIFY, aid);
+                err = iwx_send_cmd_pdu(sc, mac_cmd, 0, sizeof(mac), &mac);
+                IOLog("BE211 probe: MAC_CONFIG v4 associated aid=%u result=%d\n",
+                      static_cast<unsigned>(aid), err);
+                mac_associated = !err;
+            }
+        }
+    }
+    // Firmware can end the session automatically when MAC_CONFIG marks it associated.
+    int remove_err = 0;
+    if (mac_associated && sc->sc_be211_session_events == be211_session_reported) {
+        sc->sc_be211_session_pending = false;
+        IOLog("BE211 probe: session protection ended during association handoff\n");
+    } else {
+        remove_err = remove_protection();
+    }
+    if (mac_associated && generation == sc->sc_generation) {
+        sc->sc_be211_post_assoc_beacon = 0;
+        sc->sc_be211_peer_beacon_size = 0;
+        sc->sc_be211_post_assoc_observing = true;
+        if (!remove_err) {
+            const int beacon_err = iwx_wait_notification(sc, &sc->sc_be211_post_assoc_beacon, 1, 450);
+            IOLog("BE211 probe: post-association beacon wait result=%d\n", beacon_err);
+            if (!beacon_err) {
+                sc->sc_be211_runtime_dhcp_result = iwx_be211_dhcp_probe(sc);
+                IOLog("BE211 probe: DHCP data test result=%d\n", sc->sc_be211_runtime_dhcp_result);
+            } else {
+                IOLog("BE211 probe: DHCP skipped after beacon wait result=%d\n", beacon_err);
+            }
+        } else {
+            IOLog("BE211 probe: DHCP skipped after protection removal result=%d\n", remove_err);
+        }
+        if (generation == sc->sc_generation) {
+            auto mac = be211_mac_context(sc, IWX_FW_CTXT_ACTION_MODIFY, 0);
+            err = iwx_send_cmd_pdu(sc, mac_cmd, 0, sizeof(mac), &mac);
+            IOLog("BE211 probe: MAC_CONFIG v4 clear association result=%d\n", err);
+        } else {
+            err = ENXIO;
+        }
+        sc->sc_be211_post_assoc_observing = false;
+    }
+    return err ? err : remove_err;
+}
+
+bool ItlIwx::iwx_be211_publish_association(struct iwx_softc *sc)
+{
+    if (!sc->sc_be211_association_observer)
+        return true; // Legacy requests still use the diagnostic.
+#ifdef AIRPORT_WCL
+    constexpr size_t fixed = sizeof(ieee80211_frame) + 12;
+    const auto length = sc->sc_be211_peer_beacon_size;
+    if (length < fixed + 2)
+        return false;
+    auto *beacon = static_cast<uint8_t *>(IOMalloc(length));
+    if (!beacon)
+        return false;
+    memcpy(beacon, sc->sc_be211_peer_beacon, length);
+    ieee80211_node node = {};
+    IEEE80211_ADDR_COPY(node.ni_bssid, sc->sc_be211_auth_bssid);
+    node.ni_chan = &sc->sc_ic.ic_channels[sc->sc_be211_auth_channel];
+    node.ni_chw = IEEE80211_CHAN_WIDTH_20;
+    node.ni_rssi = sc->sc_be211_peer_beacon_rssi;
+    node.ni_intval = beacon[fixed - 4] | (beacon[fixed - 3] << 8);
+    node.ni_capinfo = beacon[fixed - 2] | (beacon[fixed - 1] << 8);
+    node.ni_esslen = sc->sc_be211_auth_ssid_len;
+    memcpy(node.ni_essid, sc->sc_be211_auth_ssid, node.ni_esslen);
+    const ieee80211_beacon_event event = {&node, beacon + fixed, length - fixed, beacon, length};
+    const bool published = sc->sc_be211_association_observer(sc->sc_be211_association_context, event);
+    IOFree(beacon, length);
+    return published;
+#else
+    return false;
+#endif
+}
+
+bool ItlIwx::copyBE211PeerBeacon(void *out, size_t capacity) const
+{
+    const uint32_t length = com.sc_be211_peer_beacon_size;
+    if (!out || !be211BSDActive() || !length || capacity < sizeof(length) + length)
+        return false;
+    bzero(out, capacity);
+    memcpy(out, &length, sizeof(length));
+    memcpy(static_cast<uint8_t *>(out) + sizeof(length), com.sc_be211_peer_beacon, length);
+    return true;
+}
+
+bool ItlIwx::copyBE211AssociationRates(ieee80211_rateset &rates) const
+{
+    // The WCL query runs under the controller gate, as do join and teardown.
+    const unsigned count = com.sc_be211_assoc_rate_count;
+    if (!be211BSDActive() || !com.sc_be211_assoc_aid || !count ||
+        count > sizeof(com.sc_be211_assoc_rates) || count > sizeof(rates.rs_rates))
+        return false;
+    rates = {};
+    rates.rs_nrates = count;
+    memcpy(rates.rs_rates, com.sc_be211_assoc_rates, count);
+    return true;
+}
+
+int ItlIwx::iwx_be211_dhcp_probe(struct iwx_softc *sc)
+{
+#ifdef AIRPORT_VTD
+    if (sc->sc_flags & IWX_FLAG_RFKILL)
+        return EPERM;
+    // Fix the rate for this experiment so the DHCP frame bypasses peer TLC.
+    unsigned basic_rate = 0;
+    unsigned lowest_rate = 0;
+    for (unsigned i = 0; i < sc->sc_be211_assoc_rate_count; ++i) {
+        const unsigned advertised = sc->sc_be211_assoc_rates[i];
+        const unsigned rate = advertised & IEEE80211_RATE_VAL;
+        if (!lowest_rate || rate < lowest_rate)
+            lowest_rate = rate;
+        if ((advertised & IEEE80211_RATE_BASIC) && (!basic_rate || rate < basic_rate))
+            basic_rate = rate;
+    }
+    const unsigned rate = basic_rate ? basic_rate : lowest_rate;
+    const unsigned antennas = iwx_fw_valid_tx_ant(sc) & sc->sc_nvm.valid_tx_ant & 0x7;
+    const unsigned ridx = iwx_rval2ridx(rate);
+    if (!rate || ridx >= nitems(iwx_rates) || !antennas) {
+        IOLog("BE211 probe: DHCP fixed rate unavailable rate500k=%u antennas=0x%x\n",
+              rate, antennas);
+        return ENOTSUP;
+    }
+    const unsigned antenna = antennas & -antennas;
+    const unsigned modulation = IWX_RIDX_IS_CCK(ridx) ? IWX_RATE_MCS_CCK_MSK : IWX_RATE_MCS_LEGACY_OFDM_MSK;
+    const unsigned rate_code = IWX_RIDX_IS_CCK(ridx) ? ridx : iwx_rate2idx(rate);
+    const uint32_t rate_flags = modulation | rate_code | (antenna << IWX_RATE_MCS_ANT_POS);
+
+    auto *ifp = &sc->sc_ic.ic_if;
+    if (!ifp->controller || !ifp->iface || !ifp->if_snd.queue)
+        return ENXIO;
+
+    constexpr unsigned data_tid = 0;
+    be211_bsd_bridge bridge = {};
+    const bool allocated =
+        !iwx_dma_contig_alloc(sc->sc_dmat, &bridge.descriptors,
+                              be211_probe_slots * sizeof(iwx_tfh_tfd), 256) &&
+        !iwx_dma_contig_alloc(sc->sc_dmat, &bridge.byte_counts, be211_probe_bc_bytes, 256) &&
+        !iwx_dma_contig_alloc(sc->sc_dmat, &bridge.command,
+                              be211_probe_slots * be211_bsd_slot_bytes, be211_bsd_slot_bytes);
+    int err = ENOMEM;
+    if (allocated) {
+        const int generation = sc->sc_generation;
+        bridge.queue = IWX_INVALID_QUEUE;
+        bridge.rate_flags = rate_flags;
+        err = iwx_mld_queue_cmd(sc, be211_probe_station_mask, data_tid, 0, be211_probe_slots,
+                                bridge.descriptors.paddr, bridge.byte_counts.paddr,
+                                &bridge.queue, &bridge.ring.write);
+        bridge.ring.read = bridge.ring.write;
+        IOLog("BE211 probe: BSD queue add qid=%u wp=%u result=%d\n",
+              bridge.queue, bridge.ring.write, err);
+        const bool queue_added = !err;
+        if (!err && (bridge.queue >= 32 || bridge.queue == sc->sc_be211_auth_queue))
+            err = ENOTSUP;
+        if (generation != sc->sc_generation)
+            err = ENXIO;
+        if (!err && (sc->sc_flags & IWX_FLAG_RFKILL))
+            err = EPERM;
+        if (!err) {
+            ifq_flush(&ifp->if_snd);
+            sc->sc_be211_bsd = &bridge;
+            sc->sc_be211_bsd_stop = 0;
+            __atomic_store_n(&sc->sc_be211_bsd_active, true, __ATOMIC_RELEASE);
+            int wait = ECANCELED;
+            if (iwx_be211_publish_association(sc) && !sc->sc_be211_join_cancelled &&
+                generation == sc->sc_generation) {
+                ieee80211_set_link_state(&sc->sc_ic, LINK_STATE_UP);
+                IOLog("BE211 probe: BSD packet window started duration=until-disconnect rate500k=%u\n",
+                      rate);
+                // Poll only for faults that may not signal the stop event. A poll
+                // timeout leaves the association and firmware queues running.
+                constexpr unsigned poll_ms = 5000;
+                unsigned polls = 0;
+                do {
+                    if (sc->sc_flags & IWX_FLAG_RFKILL) {
+                        wait = EPERM;
+                        break;
+                    }
+                    if (sc->sc_flags & (IWX_FLAG_HW_ERR | IWX_FLAG_SHUTDOWN)) {
+                        wait = EIO;
+                        break;
+                    }
+                    wait = iwx_wait_notification(sc, &sc->sc_be211_bsd_stop, 1, poll_ms);
+                    if (wait == EWOULDBLOCK && ++polls % 12 == 0)
+                        IOLog("BE211 probe: BSD link heartbeat tx=%u rx=%u reclaimed=%u pending=%u invalid_completions=%u failed_completions=%u\n",
+                              bridge.tx, bridge.rx, bridge.reclaimed, bridge.ring.pending(),
+                              bridge.invalid_completions, bridge.failed_completions);
+                } while (wait == EWOULDBLOCK);
+            }
+            __atomic_store_n(&sc->sc_be211_bsd_active, false, __ATOMIC_RELEASE);
+            sc->sc_be211_bsd = nullptr;
+            ieee80211_set_link_state(&sc->sc_ic, LINK_STATE_DOWN);
+            if (sc->sc_be211_join_cancelled)
+                err = ECANCELED;
+            else
+                err = wait ? wait : ECONNRESET;
+            IOLog("BE211 probe: BSD packet window complete tx=%u rx=%u ack_forwarded=%u result=%d dequeued=%u wait=%d cancelled=%u\n",
+                  bridge.tx, bridge.rx, static_cast<unsigned>(bridge.ack_forwarded), err, bridge.dequeued,
+                  wait, static_cast<unsigned>(sc->sc_be211_join_cancelled));
+            IOLog("BE211 probe: BSD ICMP window requests=%u replies=%u\n",
+                  bridge.echo_tx, bridge.echo_rx);
+            IOLog("BE211 probe: BSD web window tx=%u rx=%u\n", bridge.web_tx, bridge.web_rx);
+            IOLog("BE211 probe: BSD TX ring tx=%u reclaimed=%u pending=%u peak=%u full_events=%u invalid_completions=%u failed_completions=%u\n",
+                  bridge.tx, bridge.reclaimed, bridge.ring.pending(), bridge.max_pending,
+                  bridge.full_events, bridge.invalid_completions, bridge.failed_completions);
+        }
+        if (queue_added && generation == sc->sc_generation) {
+            const int cleanup = iwx_mld_queue_cmd(sc, be211_probe_station_mask, data_tid,
+                                                 1, 0, 0, 0, nullptr, nullptr);
+            IOLog("BE211 probe: BSD queue remove result=%d\n", cleanup);
+            if (!err)
+                err = cleanup;
+        }
+        // The firmware may still reference submitted buffers until the device stops.
+        sc->sc_dmat->deferRecycling();
+    }
+    iwx_dma_contig_free(&bridge.command);
+    iwx_dma_contig_free(&bridge.byte_counts);
+    iwx_dma_contig_free(&bridge.descriptors);
+    return err;
+#else
+    return ENOTSUP;
+#endif
+}
+
+void ItlIwx::iwx_be211_bsd_output(struct iwx_softc *sc)
+{
+    auto &bridge = *sc->sc_be211_bsd;
+    auto *ifp = &sc->sc_ic.ic_if;
+    while (!sc->sc_be211_bsd_stop &&
+           !(sc->sc_flags & (IWX_FLAG_RFKILL | IWX_FLAG_HW_ERR | IWX_FLAG_SHUTDOWN))) {
+        // Keep one slot empty and leave pending packets in the BSD queue.
+        if (bridge.ring.pending() >= be211_probe_slots - 1) {
+            if (!bridge.tx_waiting && !ifq_empty(&ifp->if_snd)) {
+                bridge.tx_waiting = true;
+                ++bridge.full_events;
+            }
+            break;
+        }
+        mbuf_t m = ifq_dequeue(&ifp->if_snd);
+        if (!m)
+            break;
+        ++bridge.dequeued;
+        const size_t length = mbuf_pkthdr_len(m);
+        ether_header ethernet = {};
+        if (length <= sizeof(ethernet) || length > sizeof(ethernet) + ETHERMTU ||
+            mbuf_copydata(m, 0, sizeof(ethernet), &ethernet)) {
+            mbuf_freem(m);
+            continue;
+        }
+        if (!IEEE80211_ADDR_EQ(ethernet.ether_shost, sc->sc_nvm.hw_addr)) {
+            if (!bridge.mac_mismatch) {
+                bridge.mac_mismatch = true;
+                IOLog("BE211 probe: BSD TX source MAC differs from association MAC\n");
+            }
+            mbuf_freem(m);
+            continue;
+        }
+        const unsigned protocol = ntohs(ethernet.ether_type);
+        if (protocol != ETHERTYPE_IP && protocol != ETHERTYPE_ARP) {
+            mbuf_freem(m);
+            continue;
+        }
+        const unsigned index = bridge.ring.index();
+        const unsigned command_offset = index * be211_bsd_slot_bytes;
+        auto *buffer = static_cast<uint8_t *>(bridge.command.vaddr) + command_offset;
+        bzero(buffer, be211_bsd_slot_bytes);
+        auto *snap = buffer + be211_probe_body_offset;
+        auto *payload = snap + be211_snap_size;
+        const unsigned payload_size = length - sizeof(ethernet);
+        static_assert(be211_probe_body_offset + be211_snap_size + ETHERMTU <= be211_bsd_slot_bytes,
+                      "BSD TX command buffer");
+        const auto copy_error = mbuf_copydata(m, sizeof(ethernet), payload_size, payload);
+        mbuf_freem(m);
+        if (copy_error)
+            continue;
+
+        uint8_t dhcp_type = 0;
+        const uint8_t *echo = nullptr;
+        if (protocol == ETHERTYPE_IP && bridge.ack_forwarded &&
+            bridge.echo_tx < be211_echo_budget && !(ethernet.ether_dhost[0] & 1))
+            echo = be211_echo_header(payload, payload_size, 8);
+
+        const unsigned web_port = protocol == ETHERTYPE_IP && bridge.ack_forwarded &&
+            !(ethernet.ether_dhost[0] & 1) ?
+            be211_web_port(payload, payload_size, true, bridge.lease_address) : 0;
+        if (web_port) {
+            ++bridge.web_tx;
+        } else if (echo) {
+            auto &request = bridge.echoes[bridge.echo_tx++];
+            memcpy(request.addresses, payload + 12, sizeof(request.addresses));
+            memcpy(request.identifier_sequence, echo + 4, sizeof(request.identifier_sequence));
+            request.pending = true;
+        } else {
+            if (protocol == ETHERTYPE_IP) {
+                uint32_t xid = 0;
+                dhcp_type = be211_dhcp_type(payload, payload_size, true, sc->sc_nvm.hw_addr, &xid);
+                if (dhcp_type != be211_dhcp_discover && dhcp_type != be211_dhcp_request)
+                    continue;
+                bridge.xid = xid;
+                bridge.xid_valid = true;
+            } else if (payload_size < 28) {
+                continue;
+            }
+        }
+
+        memcpy(snap, be211_snap_prefix, sizeof(be211_snap_prefix));
+        memcpy(snap + sizeof(be211_snap_prefix), &ethernet.ether_type, sizeof(ethernet.ether_type));
+        const unsigned body_size = be211_snap_size + payload_size;
+        auto *packet = reinterpret_cast<be211_probe_tx_command *>(buffer);
+        const unsigned frame_size = sizeof(packet->frame) + body_size;
+        packet->header.cmd = IWX_TX_CMD;
+        packet->header.idx = index;
+        packet->header.qid = bridge.queue;
+        packet->tx.len = htole16(frame_size);
+        packet->tx.flags = htole16(IWX_TX_FLAGS_ENCRYPT_DIS | IWX_TX_FLAGS_CMD_RATE);
+        packet->tx.rate_n_flags = htole32(bridge.rate_flags);
+        packet->tx.offload_assist = htole32(itlTxOffloadHeader(sizeof(packet->frame), false));
+        packet->frame.i_fc[0] = IEEE80211_FC0_TYPE_DATA;
+        packet->frame.i_fc[1] = IEEE80211_FC1_DIR_TODS;
+        IEEE80211_ADDR_COPY(packet->frame.i_addr1, sc->sc_be211_auth_bssid);
+        IEEE80211_ADDR_COPY(packet->frame.i_addr2, sc->sc_nvm.hw_addr);
+        IEEE80211_ADDR_COPY(packet->frame.i_addr3, ethernet.ether_dhost);
+
+        auto &descriptor = static_cast<iwx_tfh_tfd *>(bridge.descriptors.vaddr)[index];
+        be211_fill_probe_tfd(descriptor, bridge.command.paddr + command_offset, body_size);
+        static_cast<uint16_t *>(bridge.byte_counts.vaddr)[index] = htole16(frame_size);
+        ++bridge.ring.write;
+        bridge.max_pending = MAX(bridge.max_pending, bridge.ring.pending());
+        if (!index && bridge.tx && (bridge.tx <= 256 || !(bridge.tx & 4095)))
+            IOLog("BE211 probe: BSD TX ring wrapped tx=%u reclaimed=%u write=%u\n",
+                  bridge.tx, bridge.reclaimed, static_cast<unsigned>(bridge.ring.write));
+        ++bridge.tx;
+        if (bridge.tx <= be211_web_trace_limit || dhcp_type)
+            IOLog("BE211 probe: BSD TX index=%u protocol=0x%x DHCP type=%u bytes=%u\n",
+                  index, protocol, dhcp_type, frame_size);
+        if (echo)
+            IOLog("BE211 probe: BSD ICMP TX index=%u id=%u seq=%u\n",
+                  index, be211_get_be16(echo + 4), be211_get_be16(echo + 6));
+        if (web_port && bridge.web_tx <= be211_web_trace_limit)
+            IOLog("BE211 probe: BSD web TX index=%u ip_protocol=%u remote_port=%u bytes=%u\n",
+                  index, payload[9], web_port, payload_size);
+        OSSynchronizeIO();
+        IWX_WRITE(sc, IWX_HBUS_TARG_WRPTR, (uint32_t(bridge.queue) << 16) | bridge.ring.write);
+    }
+}
+
+int ItlIwx::iwx_be211_mgmt_queue_probe(struct iwx_softc *sc)
+{
+#ifdef AIRPORT_VTD
+    const unsigned cmd_version = iwx_lookup_cmd_ver(sc, IWX_DATA_PATH_GROUP,
+                                                     IWX_MLD_SCD_QUEUE_CONFIG_CMD);
+    const unsigned response_version = iwx_lookup_notif_ver(sc, IWX_DATA_PATH_GROUP,
+                                                           IWX_MLD_SCD_QUEUE_CONFIG_CMD);
+    IOLog("BE211 probe: management queue versions command=%u response=%u\n",
+          cmd_version, response_version);
+    if (cmd_version != 3 || response_version != 2)
+        return ENOTSUP;
+
+    constexpr unsigned slots = be211_probe_slots;
+    constexpr size_t byte_count_table_size = be211_probe_bc_bytes;
+    constexpr uint32_t station_mask = be211_probe_station_mask;
+    struct iwx_dma_info descriptors = {};
+    struct iwx_dma_info byte_counts = {};
+    int err = iwx_dma_contig_alloc(sc->sc_dmat, &descriptors,
+                                   slots * sizeof(iwx_tfh_tfd), 256);
+    if (err)
+        return ENOMEM;
+    err = iwx_dma_contig_alloc(sc->sc_dmat, &byte_counts, byte_count_table_size, 256);
+    if (err) {
+        iwx_dma_contig_free(&descriptors);
+        return ENOMEM;
+    }
+
+    struct iwx_dma_info auth_command = {};
+    if (sc->sc_be211_auth_target_configured &&
+        iwx_dma_contig_alloc(sc->sc_dmat, &auth_command,
+                             2 * be211_mgmt_command_stride, be211_mgmt_command_stride)) {
+        iwx_dma_contig_free(&byte_counts);
+        iwx_dma_contig_free(&descriptors);
+        return ENOMEM;
+    }
+
+    IOLog("BE211 probe: management queue DMA TFD bytes=%u BC bytes=%zu cb_size=%u\n",
+          static_cast<unsigned>(descriptors.size), byte_count_table_size,
+          static_cast<unsigned>(IWX_TFD_QUEUE_CB_SIZE(slots)));
+    IOLog("BE211 probe: management queue host ring 1 allocated=%u\n",
+          static_cast<unsigned>(sc->txq[1].desc_dma.vaddr != nullptr));
+    uint16_t queue = IWX_INVALID_QUEUE;
+    uint16_t write_pointer = 0;
+    const int generation = sc->sc_generation;
+    err = iwx_mld_queue_cmd(sc, station_mask, IWX_MGMT_TID, 0, slots,
+                            descriptors.paddr, byte_counts.paddr, &queue, &write_pointer);
+    IOLog("BE211 probe: SCD_QUEUE_CONFIG v3 add tid=%u slots=%u qid=%u wp=%u result=%d\n",
+          static_cast<unsigned>(IWX_MGMT_TID), slots, static_cast<unsigned>(queue),
+          static_cast<unsigned>(write_pointer), err);
+    if (!err && generation == sc->sc_generation && sc->sc_be211_auth_target_configured)
+        err = iwx_be211_auth_probe(sc, queue, write_pointer, slots, descriptors,
+                                    byte_counts, auth_command);
+    if (!err && generation == sc->sc_generation) {
+        err = iwx_mld_queue_cmd(sc, station_mask, IWX_MGMT_TID, 1, 0,
+                                0, 0, nullptr, nullptr);
+        IOLog("BE211 probe: SCD_QUEUE_CONFIG v3 remove result=%d\n", err);
+    }
+    if (generation != sc->sc_generation)
+        err = ENXIO;
+
+    // Keep submitted DMA pages out of the allocator until device stop.
+    sc->sc_dmat->deferRecycling();
+    iwx_dma_contig_free(&auth_command);
+    iwx_dma_contig_free(&byte_counts);
+    iwx_dma_contig_free(&descriptors);
+    return err;
+#else
+    return ENOTSUP;
+#endif
+}
