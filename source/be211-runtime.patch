+void be211_fill_probe_tfd(iwx_tfh_tfd &descriptor, uint64_t address, unsigned body_size)
+{
+    descriptor.num_tbs = htole16(3);
+    descriptor.tbs[0].tb_len = htole16(IWX_FIRST_TB_SIZE);
+    descriptor.tbs[1].tb_len = htole16(sizeof(be211_probe_tx_command) - IWX_FIRST_TB_SIZE);
+    descriptor.tbs[2].tb_len = htole16(body_size);
+    const uint64_t addresses[] = { htole64(address), htole64(address + IWX_FIRST_TB_SIZE),
+                                   htole64(address + be211_probe_body_offset) };
+    for (unsigned i = 0; i < nitems(addresses); ++i)
+        memcpy(&descriptor.tbs[i].addr, &addresses[i], sizeof(addresses[i]));
+}
+
+unsigned be211_get_be16(const uint8_t *bytes)
+{
+    return (bytes[0] << 8) | bytes[1];
+}
+
+// Validate the IPv4 envelope before reading the ICMP echo header.
+const uint8_t *be211_echo_header(const uint8_t *ip, size_t length, uint8_t type)
+{
+    constexpr unsigned ipv4_min_header = 20;
+    constexpr unsigned icmp_echo_header = 8;
+    if (length < ipv4_min_header || ip[0] >> 4 != 4 || ip[9] != 1 ||
+        (be211_get_be16(ip + 6) & 0x3fff))
+        return nullptr;
+    const unsigned header = (ip[0] & 0xf) * 4;
+    const unsigned size = be211_get_be16(ip + 2);
+    if (header < ipv4_min_header || size > length || size < header + icmp_echo_header)
+        return nullptr;
+    const auto *icmp = ip + header;
+    return icmp[0] == type && icmp[1] == 0 ? icmp : nullptr;
+}
+
+// Admit one small IPv4 web test on the address assigned to this window.
+unsigned be211_web_port(const uint8_t *ip, size_t length, bool outgoing, const uint8_t *lease)
+{
+    if (length < 20 || ip[0] >> 4 != 4 || (be211_get_be16(ip + 6) & 0x3fff) ||
+        !(lease[0] | lease[1] | lease[2] | lease[3]) ||
+        memcmp(ip + (outgoing ? 12 : 16), lease, 4))
+        return 0;
+    const unsigned header = (ip[0] & 0xf) * 4;
+    const unsigned size = be211_get_be16(ip + 2);
+    if (header < 20 || size > length || size < header + 8)
+        return 0;
+    const auto *transport = ip + header;
+    const unsigned port = be211_get_be16(transport + (outgoing ? 2 : 0));
+    const unsigned transport_size = size - header;
+    if (ip[9] == 17)
+        return port == 53 && transport_size == be211_get_be16(transport + 4) ? port : 0;
+    if (ip[9] != 6 || transport_size < 20)
+        return 0;
+    const unsigned tcp_header = (transport[12] >> 4) * 4;
+    return tcp_header >= 20 && tcp_header <= transport_size && (port == 53 || port == 443) ? port : 0;
+}
+
+// Return a DHCP message type and keep the host client's transaction ID intact.
+uint8_t be211_dhcp_type(const uint8_t *ip, size_t length, bool outgoing, const uint8_t *mac,
+                        uint32_t *xid, uint8_t *offered_address = nullptr)
+{
+    if (length < 20 || ip[0] >> 4 != 4 || ip[9] != 17 ||
+        (be211_get_be16(ip + 6) & 0x3fff))
+        return 0;
+    const unsigned ip_header = (ip[0] & 0xf) * 4;
+    const unsigned ip_size = be211_get_be16(ip + 2);
+    if (ip_header < 20 || ip_size > length ||
+        ip_size < ip_header + be211_udp_header + be211_dhcp_options)
+        return 0;
+    const auto *udp = ip + ip_header;
+    const unsigned udp_size = be211_get_be16(udp + 4);
+    if (be211_get_be16(udp) != (outgoing ? 68U : 67U) ||
+        be211_get_be16(udp + 2) != (outgoing ? 67U : 68U) ||
+        udp_size < be211_udp_header + be211_dhcp_options || udp_size > ip_size - ip_header)
+        return 0;
+    const auto *dhcp = udp + be211_udp_header;
+    if (dhcp[0] != (outgoing ? 1 : 2) || dhcp[1] != 1 || dhcp[2] != IEEE80211_ADDR_LEN ||
+        !IEEE80211_ADDR_EQ(dhcp + 28, mac) ||
+        memcmp(dhcp + be211_bootp_fixed, be211_dhcp_cookie, sizeof(be211_dhcp_cookie)))
+        return 0;
+    const size_t options_end = udp_size - be211_udp_header;
+    uint8_t type = 0;
+    for (size_t pos = be211_dhcp_options; pos < options_end;) {
+        const unsigned option = dhcp[pos++];
+        if (option == 255) {
+            memcpy(xid, dhcp + 4, sizeof(*xid));
+            if (offered_address && type == be211_dhcp_ack)
+                memcpy(offered_address, dhcp + 16, 4);
+            return type;
+        }
+        if (!option)
+            continue;
+        if (pos == options_end || dhcp[pos] > options_end - pos - 1)
+            return 0;
+        const unsigned size = dhcp[pos++];
+        if (option == 53 && size == 1)
+            type = dhcp[pos];
+        pos += size;
+    }
+    return 0;
+}
+
