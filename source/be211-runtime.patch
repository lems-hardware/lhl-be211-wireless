+int ItlIwx::iwx_be211_context_probe(struct iwx_softc *sc, unsigned channel)
+{
+    unsigned phy_version = iwx_lookup_cmd_ver(sc, IWX_LONG_GROUP, IWX_PHY_CONTEXT_CMD);
+    unsigned mac_version = iwx_lookup_cmd_ver(sc, IWX_MAC_CONF_GROUP, IWX_MLD_MAC_CONFIG_CMD);
+    unsigned link_version = iwx_lookup_cmd_ver(sc, IWX_MAC_CONF_GROUP, IWX_MLD_LINK_CONFIG_CMD);
+    unsigned sta_version = iwx_lookup_cmd_ver(sc, IWX_MAC_CONF_GROUP, IWX_MLD_STA_CONFIG_CMD);
+    unsigned remove_version = iwx_lookup_cmd_ver(sc, IWX_MAC_CONF_GROUP, IWX_MLD_STA_REMOVE_CMD);
+    IOLog("BE211 probe: context versions PHY=%u MAC=%u LINK=%u STA=%u STA_REMOVE=%u\n",
+          phy_version, mac_version, link_version, sta_version, remove_version);
+    // Core 106 omits STA_REMOVE from its version table. Use the base v1 ABI.
+    if (phy_version != 6 || mac_version != 4 || link_version != 8 || sta_version != 3 ||
+        (remove_version != 1 && remove_version != IWX_FW_CMD_VER_UNKNOWN) ||
+        channel < 1 || channel > 11)
+        return ENOTSUP;
+    if (sc->sc_flags & IWX_FLAG_RFKILL)
+        return EPERM;
+
+    // Create an unassociated MAC before adding the link and peer.
+    auto mac = be211_mac_context(sc, IWX_FW_CTXT_ACTION_ADD, 0);
+    const uint32_t mac_cmd = IWX_WIDE_ID(IWX_MAC_CONF_GROUP, IWX_MLD_MAC_CONFIG_CMD);
+    int err = iwx_send_cmd_pdu(sc, mac_cmd, 0, sizeof(mac), &mac);
+    IOLog("BE211 probe: MAC_CONFIG v4 add result=%d\n", err);
+    if (err)
+        return err;
+
+    struct iwx_be211_phy_context_v6 phy = {};
+    phy.action = htole32(IWX_FW_CTXT_ACTION_ADD);
+    phy.channel.channel = htole32(channel);
+    phy.channel.band = IWX_PHY_BAND_24;
+    phy.channel.width = IWX_PHY_VHT_CHANNEL_MODE20;
+    phy.secondary_control_location = IWX_PHY_VHT_CTRL_POS_1_ABOVE;
+    err = iwx_send_cmd_pdu(sc, IWX_PHY_CONTEXT_CMD, 0, sizeof(phy), &phy);
+    IOLog("BE211 probe: PHY_CONTEXT v6 add channel=%u result=%d\n", channel, err);
+    if (!err) {
+        // Firmware context IDs are all zero. The link starts without a PHY.
+        struct iwx_be211_link_context_v8 link = {};
+        const uint32_t link_cmd = IWX_WIDE_ID(IWX_MAC_CONF_GROUP, IWX_MLD_LINK_CONFIG_CMD);
+        link.action = htole32(IWX_FW_CTXT_ACTION_ADD);
+        link.phy_id = htole32(IWX_FW_CTXT_INVALID);
+        IEEE80211_ADDR_COPY(link.local_address, sc->sc_nvm.hw_addr);
+        err = iwx_send_cmd_pdu(sc, link_cmd, 0, sizeof(link), &link);
+        IOLog("BE211 probe: LINK_CONFIG v8 add bytes=%zu result=%d\n", sizeof(link), err);
+        if (err)
+            return err; // Preinit resets firmware and discards all contexts.
+
+        // Bind the PHY while the link is inactive, with basic 2.4 GHz rates.
+        link.action = htole32(IWX_FW_CTXT_ACTION_MODIFY);
+        link.phy_id = 0;
+        link.modify_mask = htole32(IWX_MLD_LINK_CONTEXT_MODIFY_RATES_INFO);
+        link.cck_rates = htole32((1U << IWX_RATE_1M_INDEX) | (1U << IWX_RATE_2M_INDEX) |
+                                (1U << IWX_RATE_5M_INDEX) | (1U << IWX_RATE_11M_INDEX));
+        link.ofdm_rates = htole32(((1U << IWX_RATE_6M_INDEX) | (1U << IWX_RATE_12M_INDEX) |
+                                 (1U << IWX_RATE_24M_INDEX)) >> IWX_FIRST_OFDM_RATE);
+        err = iwx_send_cmd_pdu(sc, link_cmd, 0, sizeof(link), &link);
+        IOLog("BE211 probe: LINK_CONFIG v8 bind PHY=0 channel=%u result=%d\n", channel, err);
+        if (err)
+            return err;
+
+        // Try the pre-association payload observed on AX211 with this assert.
+        link.modify_mask = htole32(IWX_MLD_LINK_CONTEXT_MODIFY_ACTIVE |
+                                   IWX_MLD_LINK_CONTEXT_MODIFY_RATES_INFO);
+        link.active = htole32(1);
+        // Firmware uses contiguous legacy indices, including 24 Mbps at bit 4.
+        link.ofdm_rates = htole32((1U << 0) | (1U << 2) | (1U << 4)); // 6, 12, 24 Mbps
+        link.beacon_interval = htole32(sc->sc_be211_peer_beacon_interval);
+        link.qos_flags = htole32(IWX_MAC_QOS_FLG_TGN);
+        constexpr uint8_t aifsn[] = {7, 3, 2, 2}; // BK, BE, VI, VO
+        static_assert(nitems(aifsn) == IWX_AC_NUM, "LINK_CONFIG v8 EDCA categories");
+        for (unsigned ac = 0; ac < nitems(aifsn); ++ac) {
+            link.ac[ac].cw_min = htole16(15);
+            link.ac[ac].cw_max = htole16(1023);
+            link.ac[ac].aifsn = aifsn[ac];
+            link.ac[ac].fifos_mask = 1U << (ac + 1);
+        }
+        IOLog("BE211 probe: activate request cmd=0x%x bytes=%zu mask=0x%x "
+              "link=%u mac=%u phy=%u state=%u cck=0x%x ofdm=0x%x beacon=%u qos=0x%x\n",
+              link_cmd, sizeof(link), le32toh(link.modify_mask), le32toh(link.link_id),
+              le32toh(link.mac_id), le32toh(link.phy_id), le32toh(link.active),
+              le32toh(link.cck_rates), le32toh(link.ofdm_rates),
+              le32toh(link.beacon_interval), le32toh(link.qos_flags));
+        err = iwx_send_cmd_pdu(sc, link_cmd, 0, sizeof(link), &link);
+        IOLog("BE211 probe: LINK_CONFIG v8 activate result=%d\n", err);
+        if (err)
+            return err;
+
+        // Register the observed AP on link 0 before allocating the queue.
+        auto peer = be211_peer_context(sc, 0);
+        err = iwx_send_cmd_pdu(sc, IWX_WIDE_ID(IWX_MAC_CONF_GROUP, IWX_MLD_STA_CONFIG_CMD),
+                               0, sizeof(peer), &peer);
+        IOLog("BE211 probe: STA_CONFIG v3 add bytes=%zu result=%d\n", sizeof(peer), err);
+        if (err)
+            return err;
+
+        err = iwx_be211_mgmt_queue_probe(sc);
+        if (err)
+            return err;
+
+        struct iwx_mld_mvm_remove_sta_cmd remove_peer = {};
+        remove_peer.sta_id = peer.sta_id;
+        err = iwx_send_cmd_pdu(sc, IWX_WIDE_ID(IWX_MAC_CONF_GROUP, IWX_MLD_STA_REMOVE_CMD),
+                               0, sizeof(remove_peer), &remove_peer);
+        IOLog("BE211 probe: STA_REMOVE v1 result=%d\n", err);
+        if (err)
+            return err;
+
+        link.modify_mask = htole32(IWX_MLD_LINK_CONTEXT_MODIFY_ACTIVE);
+        link.active = 0;
+        err = iwx_send_cmd_pdu(sc, link_cmd, 0, sizeof(link), &link);
+        IOLog("BE211 probe: LINK_CONFIG v8 deactivate result=%d\n", err);
+        if (err)
+            return err;
+
+        link = {};
+        link.action = htole32(IWX_FW_CTXT_ACTION_REMOVE);
+        link.phy_id = htole32(IWX_FW_CTXT_INVALID);
+        err = iwx_send_cmd_pdu(sc, link_cmd, 0, sizeof(link), &link);
+        IOLog("BE211 probe: LINK_CONFIG v8 remove result=%d\n", err);
+        if (err)
+            return err;
+
+        phy.action = htole32(IWX_FW_CTXT_ACTION_REMOVE);
+        err = iwx_send_cmd_pdu(sc, IWX_PHY_CONTEXT_CMD, 0, sizeof(phy), &phy);
+        IOLog("BE211 probe: PHY_CONTEXT v6 remove result=%d\n", err);
+    }
+
+    mac = {};
+    mac.action = htole32(IWX_FW_CTXT_ACTION_REMOVE);
+    int remove_err = iwx_send_cmd_pdu(sc, mac_cmd, 0, sizeof(mac), &mac);
+    IOLog("BE211 probe: MAC_CONFIG v4 remove result=%d\n", remove_err);
+    return err ? err : remove_err;
+}
+
+int ItlIwx::scanBE211(uint16_t channels)
+{
+    auto sc = &com;
+    if (!isBE211ScanOnly() || !getMainWorkLoop()->inGate() ||
+        getMainWorkLoop()->onThread() || !channels)
+        return EINVAL;
+    if (be211ScanBusy())
+        return EBUSY;
+
+    sc->sc_be211_runtime_scan = true;
+    sc->sc_be211_requested_channels = channels;
+    const int generation = sc->sc_generation;
+    int err = iwx_start_hw(sc);
+    if (!err)
+        err = iwx_run_init_mvm_ucode(sc, 0);
+    if (generation == sc->sc_generation)
+        iwx_stop_device(sc);
+    else
+        err = ENXIO;
+    sc->sc_be211_runtime_scan = false;
+    return err;
+}
